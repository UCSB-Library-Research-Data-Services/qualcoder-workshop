library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(stringdist)
coded_data <- bind_rows(
read_csv("desktop/alexw-all.csv"),
read_csv("desktop/lucas-all.csv")
) %>%
group_by(file, coder, codename) %>%
summarise(value = 1, text = paste(coded, collapse = " || "), .groups = "drop") %>%
complete(file, coder, codename, fill = list(value = 0, text = NA)) %>%
pivot_wider(names_from = coder, values_from = c(value, text)) %>%
filter(value_alexw == 1 | value_lucas == 1) %>%
# Expand || segments into separate rows
mutate(
text_alexw_split = str_split(text_alexw, "\\|\\|"),
text_lucas_split = str_split(text_lucas, "\\|\\|")
) %>%
rowwise() %>%
mutate(
max_len = max(length(text_alexw_split), length(text_lucas_split)),
text_alexw_split = list(c(text_alexw_split, rep(NA, max_len - length(text_alexw_split)))),
text_lucas_split = list(c(text_lucas_split, rep(NA, max_len - length(text_lucas_split))))
) %>%
ungroup() %>%
unnest(c(text_alexw_split, text_lucas_split)) %>%
mutate(
text_alexw = str_trim(text_alexw_split),
text_lucas = str_trim(text_lucas_split)
) %>%
select(-text_alexw_split, -text_lucas_split, -max_len) %>%
# Compute agreement metrics
mutate(
agree                = value_alexw == value_lucas,
exact_match          = text_alexw == text_lucas,
partial_match_3words = mapply(\(a, b) {
trig <- \(t) { w <- str_split(t, "\\s+")[[1]]; if (length(w) < 3) return(character())
sapply(seq_len(length(w) - 2), \(i) paste(w[i:(i+2)], collapse = " ")) }
length(intersect(trig(a), trig(b))) > 0
}, text_alexw, text_lucas),
jaccard_score        = 1 - stringdist(text_alexw, text_lucas, method = "jaccard", q = 1),
length_alexw         = nchar(text_alexw),
length_lucas         = nchar(text_lucas)
)
write_csv(coded_data, "coded_data.csv")
with(coded_data, cat(
"Agree AND Partial match (3 words):", sum(agree & partial_match_3words, na.rm = TRUE), "\n",
"Agree AND Exact match:",             sum(agree & exact_match,           na.rm = TRUE), "\n",
"Disagree AND Exact match:",          sum(!agree & exact_match,          na.rm = TRUE), "\n"
))
View(coded_data)
# Get unique texts for each coder
get_unique <- function(data, col) {
data %>% select(file, text = {{col}}) %>% filter(!is.na(text)) %>% distinct(text, .keep_all = TRUE)
}
unique_alexw <- get_unique(coded_data, text_alexw)
unique_lucas <- get_unique(coded_data, text_lucas)
# Find truly unique texts (no exact or contained in the other set)
