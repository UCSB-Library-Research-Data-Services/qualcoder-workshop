jaccard_similarity <- function(str1, str2) {
if (is.na(str1) | is.na(str2)) return(NA_real_)
words1 <- unique(unlist(strsplit(tolower(str1), "\\s+")))
words2 <- unique(unlist(strsplit(tolower(str2), "\\s+")))
length(intersect(words1, words2)) / length(union(words1, words2))
}
# Get unique non-NA texts for each coder
get_unique <- function(data, col) {
data %>% select(file, text = {{col}}) %>% filter(!is.na(text)) %>% distinct(text, .keep_all = TRUE)
}
unique_alexw <- get_unique(coded_data, text_alexw)
unique_lucas <- get_unique(coded_data, text_lucas)
# Find truly unique texts (no exact OR close match in the other set)
find_unique <- function(set_a, set_b, threshold = 0.4) {
set_a %>%
anti_join(set_b, by = "text") %>%
rowwise() %>%
filter(!any(sapply(set_b$text, function(x) jaccard_similarity(text, x)) > threshold)) %>%
ungroup()
}
only_alexw_unique <- find_unique(unique_alexw, unique_lucas)
