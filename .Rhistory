set_a %>%
anti_join(set_b, by = "text") %>%
filter(!sapply(text, function(x)
any(sapply(set_b$text, function(y) grepl(x, y, fixed = TRUE))) |  # x is contained in y
any(sapply(set_b$text, function(y) grepl(y, x, fixed = TRUE)))    # y is contained in x
))
}
only_alexw_unique <- find_unique(unique_alexw, unique_lucas)
only_lucas_unique <- find_unique(unique_lucas, unique_alexw)
only_alexw_unique <- find_unique(unique_alexw, unique_lucas)
write_csv(only_alexw_unique, "lucas_recode.csv")
write_csv(only_lucas_unique, "alexw_recode.csv")
